worker_processes  auto;
pid "__OES_NGINX_DIR__/logs/online-exam-nginx.pid";

events {
    worker_connections  4096;
}

http {
    include       "__OES_NGINX_DIR__/conf/mime.types";
    default_type  application/octet-stream;

    log_format oes_main '$remote_addr - $remote_user [$time_local] "$request" '
                        '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
                        'rt=$request_time uct=$upstream_connect_time '
                        'uht=$upstream_header_time urt=$upstream_response_time '
                        'ua="$upstream_addr" us="$upstream_status"';

    access_log  "__OES_NGINX_DIR__/logs/online-exam-access.log"  oes_main;
    error_log   "__OES_NGINX_DIR__/logs/online-exam-error.log" warn;

    sendfile            on;
    tcp_nopush          on;
    tcp_nodelay         on;
    keepalive_timeout   65;
    types_hash_max_size 4096;
    client_max_body_size 2m;
    client_body_buffer_size 128k;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types
        text/plain
        text/css
        application/javascript
        application/json
        application/xml
        image/svg+xml;

    upstream online_exam_backend {
        least_conn;
        include "__OES_NGINX_RUNTIME_DIR__/upstream-mode.conf";
        keepalive 64;
    }

    limit_req_zone $binary_remote_addr zone=oes_auth_login:10m rate=5r/s;
    limit_req_zone $binary_remote_addr zone=oes_auth_refresh:10m rate=5r/s;
    limit_req_zone $binary_remote_addr zone=oes_exam_start:10m rate=3r/s;
    limit_req_zone $binary_remote_addr zone=oes_exam_submit:10m rate=2r/s;
    limit_conn_zone $binary_remote_addr zone=oes_per_ip_conn:10m;
    limit_req_status 429;

    server {
        listen 8080;
        server_name _;

        root "__OES_FRONTEND_DIST__";
        index index.html;

        add_header X-Content-Type-Options "nosniff" always;

        location = /api/auth/login {
            include "__OES_NGINX_RUNTIME_DIR__/login-limit.conf";

            proxy_pass http://online_exam_backend/auth/login;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 3s;
            proxy_send_timeout 15s;
            proxy_read_timeout 15s;
            proxy_next_upstream error timeout http_502 http_503 http_504;
        }

        location = /api/auth/refresh {
            include "__OES_NGINX_RUNTIME_DIR__/refresh-limit.conf";

            proxy_pass http://online_exam_backend/auth/refresh;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 3s;
            proxy_send_timeout 15s;
            proxy_read_timeout 15s;
            proxy_next_upstream error timeout http_502 http_503 http_504;
        }

        location ~ ^/api/student/exam/[^/]+/attempt/start$ {
            include "__OES_NGINX_RUNTIME_DIR__/start-limit.conf";

            rewrite ^/api/(.*)$ /$1 break;
            proxy_pass http://online_exam_backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 3s;
            proxy_send_timeout 30s;
            proxy_read_timeout 30s;
            proxy_next_upstream error timeout http_502 http_503 http_504;
        }

        location ~ ^/api/student/exam/[^/]+/attempt/submit$ {
            include "__OES_NGINX_RUNTIME_DIR__/submit-limit.conf";

            rewrite ^/api/(.*)$ /$1 break;
            proxy_pass http://online_exam_backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 3s;
            proxy_send_timeout 45s;
            proxy_read_timeout 45s;
            proxy_next_upstream error timeout http_502 http_503 http_504;
        }

        location /api/ {
            proxy_pass http://online_exam_backend/;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 3s;
            proxy_send_timeout 30s;
            proxy_read_timeout 30s;
            proxy_next_upstream error timeout http_502 http_503 http_504;
        }

        location = /backend-health/18080 {
            proxy_pass http://127.0.0.1:18080/actuator/health;
        }

        location = /backend-health/18081 {
            proxy_pass http://127.0.0.1:18081/actuator/health;
        }

        location ~* \.(?:js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf)$ {
            expires 365d;
            add_header Cache-Control "public, max-age=31536000, immutable";
            try_files $uri =404;
        }

        location = /index.html {
            add_header Cache-Control "no-cache, no-store, must-revalidate";
        }

        location / {
            try_files $uri $uri/ /index.html;
        }

        error_page 429 = @too_many_requests;
        location @too_many_requests {
            default_type application/json;
            return 429 '{"code":429,"message":"too many requests","data":null}';
        }
    }
}
