<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="LOG_LEVEL_ROOT" source="logging.level.root" defaultValue="INFO"/>
    <springProperty scope="context" name="LOG_PATTERN_LEVEL" source="logging.pattern.level" defaultValue="%5p"/>
    <springProperty scope="context" name="CONSOLE_LOG_PATTERN"
                    source="logging.pattern.console"
                    defaultValue="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} ${LOG_PATTERN_LEVEL} --- [%15.15t] %-40.40logger{39} : %msg%n%ex"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>2048</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <appender-ref ref="CONSOLE"/>
    </appender>

    <root level="${LOG_LEVEL_ROOT}">
        <appender-ref ref="ASYNC_CONSOLE"/>
    </root>
</configuration>
